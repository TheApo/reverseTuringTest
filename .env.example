# Pflicht: Passwort für /admin
ADMIN_PASSWORD=bitte-aendern

# Optional
PORT=3000
# Öffentliche Adresse für die QR-Codes, z. B. die cloudflared-URL (sonst automatisch die WLAN-IP)
PUBLIC_URL=
# Spielstand-Sicherung (leer = nicht speichern)
DATA_FILE=data/game.json
# Eigene Fragen aus dem Admin (leer = nicht speichern)
QUESTIONS_FILE=data/questions.json
# Startbestand für ein frisches Spiel: eigene Fragen und Fragenplan (leer = Zufallsplan ohne eigene Fragen)
DEFAULTS_FILE=server/defaults.json

# KI-Keys: ohne Key nutzt die jeweilige KI vorbereitete Ersatzantworten
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Modelle (Standardwerte stehen hier, bei Bedarf überschreiben)
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-5.6-terra
GEMINI_MODEL=gemini-flash-latest
